# ────────────────────────────────────────────────────────────────────────────
#  crm-automation — configuration LOCALE (Mac). À copier en .env :
#      cp .env.example .env
#  .env est ignoré par git (voir .gitignore) et ne doit JAMAIS être versionné.
#  ⚠️ Aucun identifiant CRM ici : la connexion Deciplus / Fitness Booster se
#     fait à la main dans le navigateur, jamais par script.
# ────────────────────────────────────────────────────────────────────────────

# Où déposer le JSON RECAP 2 (racine de l'application, sans slash final).
# HTTPS obligatoire, sauf http://localhost:3000 pour les essais.
RECAP2_INGEST_URL=https://mon-app.up.railway.app

# Clé de dépôt, PARTAGÉE avec la variable Railway du même nom.
# Elle protège POST /api/recap2/:mois — c'est le seul secret de la chaîne.
# 16 caractères minimum ; en générer une vraie :
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# La valeur ci-dessous est un EXEMPLE : ne pas l'utiliser.
RECAP2_INGEST_KEY=remplace-moi-par-une-cle-aleatoire-de-64-caracteres

# URL de debug du Chromium piloté par la collecte (défaut : http://127.0.0.1:9222).
# CRM_DEBUG_URL=http://127.0.0.1:9222
