# My Coach Nutrition - variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs.

# Port du serveur (optionnel, defaut 3000)
PORT=3000

# --- Generation IA (optionnel) ---
# Par defaut : MODE DEMO (recettes locales, gratuit, hors-ligne).
# Pour activer la generation par Claude, il faut LES DEUX :
#   1. une cle ci-dessous
#   2. l'opt-in explicite NUTRITION_AI=on (evite tout cout surprise)
# Obtenir une cle : https://console.anthropic.com/
NUTRITION_AI=off
ANTHROPIC_API_KEY=

# Modele Claude utilise pour la generation (defaut: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6
