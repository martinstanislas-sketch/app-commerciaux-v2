/* ============================================================
   My Coach Nutrition — Design system premium
   Inspiration : Apple Health / Levels / Whoop / Eight Sleep
   Calme, epure, chaleureux, rassurant. Mobile-first.
   ============================================================ */

:root {
  /* === Identite My Coach by Ginkgo (source de verite) === */
  /* === THEME SOMBRE ENERGIQUE === */
  --mc-blue: #2F7BFF;              /* bleu electrique vif (degrades, accents) */
  --mc-blue-dark: #1A56C4;
  --mc-blue-secondary: #4D93FF;
  --mc-blue-soft: rgba(47, 123, 255, 0.16); /* tuiles d'icones translucides */
  --mc-anthracite: #F2F5FA;        /* titres clairs */
  --mc-cream: #13171E;             /* fond de page sombre */
  --mc-white: #1B212C;             /* surface des cartes */
  --mc-muted: #8B94A3;
  --mc-border: #2C333F;
  --mc-gold: #B6E84F;              /* accent lime energique (remplace le dore) */

  /* === Mapping des tokens applicatifs (accent bleu electrique) === */
  --green: var(--mc-blue);
  --green-600: var(--mc-blue-secondary);
  --green-700: #9FC2FF;            /* accent texte clair lisible sur sombre */
  --green-100: rgba(47, 123, 255, 0.30); /* bordures accent */
  --green-50: var(--mc-blue-soft); /* tuiles d'icones translucides */

  /* Neutres (sombre) */
  --beige: var(--mc-cream);
  --gray-50: #222936;             /* surface legerement plus claire */
  --gray-100: #283040;            /* chips / remplissages */
  --gray-200: var(--mc-border);
  --gray-300: #3A4453;
  --muted: var(--mc-muted);
  --ink: var(--mc-anthracite);    /* titres clairs */
  --ink-2: #C3CAD6;               /* corps clair */

  /* Information / accents */
  --blue: var(--mc-blue-secondary);
  --gold: var(--mc-gold);
  --success: #34D399;             /* vert valide */
  --warn: #E5B567;                /* ambre alertes douces */
  --error: #F87171;

  /* Surfaces */
  --card: var(--mc-white);

  /* Rayons */
  --r-sm: 12px;
  --r: 16px;
  --r-lg: 22px;
  --r-xl: 28px;
  --pill: 999px;

  /* Ombres sombres (profondes, nettes) */
  --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.40);
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.45), 0 1px 2px rgba(0, 0, 0, 0.35);
  --shadow: 0 6px 18px rgba(0, 0, 0, 0.48), 0 2px 6px rgba(0, 0, 0, 0.35);
  --shadow-md: 0 18px 40px rgba(0, 0, 0, 0.58), 0 6px 14px rgba(0, 0, 0, 0.42);
  --shadow-green: 0 12px 30px rgba(47, 123, 255, 0.42), 0 4px 10px rgba(47, 123, 255, 0.26);

  /* Accents / dégradés réutilisables */
  --grad-blue: linear-gradient(135deg, var(--mc-blue) 0%, var(--mc-blue-dark) 100%);
  --ring-blue: 0 0 0 4px rgba(47, 123, 255, 0.24);

  --font: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --ease: cubic-bezier(0.4, 0, 0.2, 1);
}

* { box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  margin: 0;
  font-family: var(--font);
  font-size: 16px;
  color: var(--ink-2);
  background: var(--beige);
  line-height: 1.6;
  letter-spacing: -0.011em;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

h1, h2, h3 { color: var(--ink); font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; margin: 0; }

.hidden { display: none !important; }

/* Icones SVG */
.ic { width: 20px; height: 20px; display: inline-block; vertical-align: middle; flex: none; stroke-width: 2; }

::selection { background: var(--green-100); color: var(--green-700); }

/* Focus accessible */
:focus-visible { outline: 3px solid rgba(30, 90, 168, 0.45); outline-offset: 2px; border-radius: 6px; }

/* ---------- Topbar ---------- */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 20px;
  background: rgba(19, 23, 30, 0.78);
  backdrop-filter: saturate(160%) blur(14px);
  -webkit-backdrop-filter: saturate(160%) blur(14px);
  border-bottom: 1px solid var(--gray-200);
  position: sticky; top: 0; z-index: 30;
}
.brand { display: flex; align-items: center; gap: 12px; }
.brand-mark {
  width: 42px; height: 42px; border-radius: 13px;
  display: grid; place-items: center; color: #fff;
  background: linear-gradient(150deg, var(--mc-blue-secondary) 0%, var(--mc-blue-dark) 100%);
  box-shadow: var(--shadow-green);
}
.brand-mark .ic { width: 22px; height: 22px; }
.brand-name { font-size: 16px; font-weight: 700; color: var(--ink); letter-spacing: -0.01em; }
.brand-name strong { color: var(--green); }
.brand-tag { font-size: 12px; color: var(--muted); margin-top: 1px; }
.topbar-right { display: flex; align-items: center; gap: 12px; }

.badge {
  font-size: 11px; font-weight: 700; padding: 5px 11px; border-radius: var(--pill);
  text-transform: uppercase; letter-spacing: 0.04em; display: inline-flex; align-items: center; gap: 5px;
}
.badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.badge-demo { background: var(--gray-100); color: var(--muted); }
.badge-demo::before { background: #B6BBC2; }
.badge-ia { background: var(--green-100); color: var(--green-700); }
.link-btn { background: var(--mc-white); border: 1px solid var(--mc-border); color: var(--ink-2); cursor: pointer; font-size: 13px; font-weight: 600; font-family: inherit; padding: 7px 14px; border-radius: var(--pill); transition: all 0.18s var(--ease); }
.link-btn:hover { border-color: var(--mc-blue); color: var(--mc-blue); background: var(--mc-blue-soft); }

/* ---------- Layout ---------- */
#app { max-width: 1320px; margin: 0 auto; padding: 28px 24px 72px; }
.screen { display: none; }
.screen.active { display: block; animation: fadeUp 0.45s var(--ease); }
@keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

/* ---------- Buttons ---------- */
.btn {
  font-family: inherit; font-size: 15px; font-weight: 700;
  border-radius: var(--pill); border: 1px solid transparent;
  padding: 12px 22px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  transition: background 0.2s var(--ease), box-shadow 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.06s var(--ease);
}
.btn:active { transform: scale(0.985); }
.btn-primary { background: linear-gradient(135deg, var(--mc-blue) 0%, var(--mc-blue-dark) 100%); color: #fff; box-shadow: var(--shadow-green); }
.btn-primary:hover { box-shadow: 0 14px 30px rgba(11, 61, 145, 0.30); }
.btn-lg { padding: 16px 30px; font-size: 17px; border-radius: 18px; }
.btn-ghost { background: var(--card); color: var(--ink-2); border-color: var(--gray-200); }
.btn-ghost:hover { background: var(--gray-50); border-color: var(--gray-300); }
.btn-outline { background: var(--card); color: var(--green-700); border-color: var(--green-100); box-shadow: var(--shadow-xs); }
.btn-outline:hover { background: var(--green-50); }

/* ---------- Landing / Hero ---------- */
.hero { text-align: center; padding: 48px 12px 28px; max-width: 720px; margin: 0 auto; }
.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 7px;
  background: var(--green-50); color: var(--green-700);
  font-size: 13px; font-weight: 700; padding: 7px 14px; border-radius: var(--pill);
  border: 1px solid var(--green-100); margin-bottom: 22px;
}
.hero-eyebrow .ic { width: 15px; height: 15px; }
.hero h1 { font-size: clamp(32px, 7vw, 44px); margin-bottom: 18px; }
.hero-sub { font-size: 18px; color: var(--muted); margin: 0 auto 28px; max-width: 560px; line-height: 1.6; }
.hero-sub strong { color: var(--ink-2); font-weight: 700; }
.btn-lg .ic { width: 18px; height: 18px; transition: transform 0.2s var(--ease); }
.btn-lg:hover .ic { transform: translateX(3px); }
.hero-points { list-style: none; padding: 0; margin: 30px auto 24px; max-width: 380px; display: grid; gap: 11px; }
.hero-points li {
  display: flex; align-items: center; gap: 12px; text-align: left;
  background: var(--card); color: var(--ink-2); font-size: 15px; font-weight: 600;
  padding: 13px 18px; border-radius: 14px; box-shadow: var(--shadow-sm); border: 1px solid var(--gray-200);
  transition: transform 0.18s var(--ease), box-shadow 0.18s var(--ease), border-color 0.18s var(--ease);
}
.hero-points li:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: var(--green-100); }
.hero-points .ic { width: 18px; height: 18px; color: #fff; background: var(--green); border-radius: 50%; padding: 3px; }
.hero-trust { display: flex; align-items: center; justify-content: center; gap: 12px; color: var(--muted); font-size: 13px; margin-top: 6px; }
.trust-avatars { display: flex; }
.trust-avatars span { width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--beige); margin-left: -8px; }
.trust-avatars span:first-child { margin-left: 0; }
.trust-avatars span:nth-child(1) { background: linear-gradient(135deg, var(--mc-blue-secondary), var(--mc-blue-dark)); }
.trust-avatars span:nth-child(2) { background: linear-gradient(135deg, #DCC79A, var(--mc-gold)); }
.trust-avatars span:nth-child(3) { background: linear-gradient(135deg, #5E80B5, var(--mc-blue)); }
.trust-avatars span:nth-child(4) { background: linear-gradient(135deg, #B7905A, #8A6D35); }
.disclaimer { font-size: 12px; color: var(--muted); margin-top: 30px; }

/* ---------- Stepper / progress ---------- */
.progress-wrap { display: flex; align-items: center; gap: 16px; margin: 6px 0 30px; max-width: 720px; margin-left: auto; margin-right: auto; }
.progress-bar { flex: 1; height: 8px; background: var(--gray-200); border-radius: var(--pill); overflow: hidden; }
.progress-fill { height: 100%; width: 14%; border-radius: var(--pill); background: linear-gradient(90deg, var(--mc-blue-secondary), var(--mc-blue)); transition: width 0.5s var(--ease); }
.progress-label { font-size: 13px; color: var(--muted); font-weight: 700; white-space: nowrap; }
.progress-label span { color: var(--green-700); }

/* ---------- Onboarding ---------- */
.step { display: none; max-width: 720px; margin: 0 auto; }
.step.active { display: block; animation: fadeUp 0.4s var(--ease); }
.step h2 { font-size: clamp(24px, 5vw, 30px); margin-bottom: 8px; }
.step-help { color: var(--muted); margin: 0 0 26px; font-size: 16px; }

.choice-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.choice {
  display: flex; flex-direction: column; align-items: flex-start; gap: 14px;
  background: var(--card); border: 1.5px solid var(--gray-200); border-radius: var(--r-lg);
  padding: 20px; font-family: inherit; font-size: 16px; font-weight: 700; color: var(--ink);
  cursor: pointer; text-align: left; box-shadow: var(--shadow-xs);
  transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease), background 0.2s var(--ease), transform 0.2s var(--ease);
}
.choice:hover { border-color: var(--green-100); box-shadow: var(--shadow); transform: translateY(-3px); }
.choice:hover .choice-ic { background: var(--green-100); }
.choice-ic { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; background: var(--green-50); color: var(--green-700); transition: all 0.2s var(--ease); }
.choice-ic .ic { width: 24px; height: 24px; }
.choice.selected { border-color: var(--green); background: var(--green-50); box-shadow: var(--shadow-green); transform: translateY(-2px); }
.choice.selected .choice-ic { background: var(--grad-blue); color: #fff; box-shadow: var(--shadow-green); }

.field { display: flex; flex-direction: column; gap: 7px; margin-bottom: 18px; }
.field > span { font-size: 14px; font-weight: 600; color: var(--ink); }
.field > span em { font-weight: 400; color: var(--muted); font-style: normal; }
.field input, .field select {
  font-family: inherit; font-size: 16px; padding: 13px 15px;
  border: 1.5px solid var(--gray-200); border-radius: 14px; background: var(--card); color: var(--ink);
  transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
}
.field input::placeholder { color: #9AA3AE; }
.field input:focus, .field select:focus { outline: none; border-color: var(--green); box-shadow: 0 0 0 4px var(--green-50); }
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.field-allergies input { border-color: rgba(229,181,103,0.5); background: rgba(229,181,103,0.08); }
.field-allergies input:focus { border-color: var(--warn); box-shadow: 0 0 0 4px rgba(229,181,103,0.18); }
.field-title { display: block; font-size: 14px; font-weight: 600; color: var(--ink); margin: 4px 0 12px; }

.chip-set { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 24px; }
.chip {
  background: var(--card); border: 1.5px solid var(--gray-200); border-radius: var(--pill);
  padding: 10px 18px; font-size: 14px; font-weight: 600; color: var(--ink-2);
  cursor: pointer; font-family: inherit; box-shadow: var(--shadow-xs);
  transition: all 0.18s var(--ease);
}
.chip:hover { border-color: var(--green-100); background: var(--green-50); }
.chip.selected { background: var(--green); color: #fff; border-color: var(--green); box-shadow: var(--shadow-green); }

.toggle-line { display: flex; align-items: center; gap: 12px; font-size: 15px; color: var(--ink-2); margin-top: 10px; cursor: pointer; }
.toggle-line input { width: 20px; height: 20px; accent-color: var(--green); }

.step-nav { display: flex; gap: 12px; margin-top: 34px; max-width: 720px; margin-left: auto; margin-right: auto; }
.step-nav .btn { flex: 1; }

/* ---------- Resultat : carte besoins (header premium) ---------- */
.needs-card {
  background:
    radial-gradient(120% 140% at 0% 0%, rgba(30,90,168,0.55) 0%, rgba(30,90,168,0) 45%),
    linear-gradient(140deg, var(--mc-blue) 0%, var(--mc-blue-dark) 100%);
  color: #fff; border-radius: var(--r-xl); padding: 28px 28px 26px; margin-bottom: 22px;
  box-shadow: 0 20px 48px rgba(7, 43, 99, 0.30), 0 6px 16px rgba(7,43,99,0.18); position: relative; overflow: hidden;
  border: 1px solid rgba(255,255,255,0.06);
  border-top: 2px solid rgba(182, 232, 79, 0.55); /* fil lime energique */
}
.needs-card::after { content: ''; position: absolute; top: -90px; right: -60px; width: 280px; height: 280px; border-radius: 50%; background: radial-gradient(circle, rgba(182,232,79,0.20), rgba(255,255,255,0) 70%); }
.needs-head { display: flex; align-items: center; gap: 13px; margin-bottom: 4px; position: relative; }
.needs-head .needs-ic { width: 44px; height: 44px; border-radius: 13px; background: rgba(255, 255, 255, 0.14); border: 1px solid rgba(182,232,79,0.45); display: grid; place-items: center; box-shadow: inset 0 1px 0 rgba(255,255,255,0.12); }
.needs-head .needs-ic .ic { color: var(--mc-gold); }
.needs-card h2 { color: #fff; font-size: 23px; letter-spacing: -0.025em; }
.needs-sub { opacity: 0.82; font-size: 13px; margin: 3px 0 22px; position: relative; }
.needs-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; position: relative; }
.needs-stat { background: rgba(255, 255, 255, 0.10); border: 1px solid rgba(255,255,255,0.12); border-radius: 16px; padding: 16px 15px; backdrop-filter: blur(6px); transition: background 0.2s var(--ease), transform 0.2s var(--ease); }
.needs-stat:hover { background: rgba(255,255,255,0.16); transform: translateY(-2px); }
.needs-stat .num { font-size: 26px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
.needs-stat .lbl { font-size: 11.5px; font-weight: 600; opacity: 0.82; margin-top: 3px; text-transform: uppercase; letter-spacing: 0.04em; }
.needs-stat .macbar { height: 6px; border-radius: var(--pill); background: rgba(255, 255, 255, 0.20); margin-top: 11px; overflow: hidden; }
.needs-stat .macbar > i { display: block; height: 100%; border-radius: var(--pill); background: linear-gradient(90deg, var(--mc-gold), #D4F58A); box-shadow: 0 0 10px rgba(182,232,79,0.55); transition: width 0.6s var(--ease); }

/* ---------- Actions rapides (cartes) ---------- */
.actions-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(152px, 1fr)); gap: 14px; margin-bottom: 18px; }
.action-card {
  display: flex; flex-direction: column; align-items: flex-start; gap: 13px;
  background: var(--card); border: 1px solid var(--gray-200); border-radius: var(--r); padding: 17px;
  font-family: inherit; font-size: 14px; font-weight: 700; color: var(--ink); cursor: pointer; text-align: left;
  box-shadow: var(--shadow-sm); position: relative;
  transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease), border-color 0.2s var(--ease);
}
.action-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md), var(--ring-blue); border-color: var(--green-100); }
.action-ic { width: 42px; height: 42px; border-radius: 13px; display: grid; place-items: center; background: var(--green-50); color: var(--green-700); box-shadow: inset 0 0 0 1px rgba(30,90,168,0.06); transition: all 0.2s var(--ease); }
.action-card:hover .action-ic { background: var(--grad-blue); color: #fff; box-shadow: var(--shadow-green); transform: scale(1.04); }

.result-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 24px; }
.save-state { font-size: 13px; color: var(--muted); margin-left: auto; display: inline-flex; align-items: center; gap: 6px; }

.portions-ctrl { display: flex; align-items: center; gap: 10px; background: var(--card); border: 1px solid var(--gray-200); border-radius: var(--pill); padding: 6px 8px 6px 16px; font-size: 13px; font-weight: 600; color: var(--muted); box-shadow: var(--shadow-xs); }
.portions-ctrl strong { color: var(--ink); font-size: 16px; min-width: 18px; text-align: center; }
.portions-ctrl button { width: 30px; height: 30px; border-radius: 50%; border: none; background: var(--green-50); color: var(--green-700); cursor: pointer; display: grid; place-items: center; transition: background 0.18s var(--ease); }
.portions-ctrl button:hover { background: var(--green-100); }
.portions-ctrl button .ic { width: 16px; height: 16px; }

/* ---------- Plan : jours + cartes repas ---------- */
.plan-grid { display: grid; gap: 18px; }
.day-card { background: var(--card); border: 1px solid var(--gray-200); border-radius: var(--r-lg); padding: 20px; box-shadow: var(--shadow-sm); transition: box-shadow 0.2s var(--ease); }
.day-card:hover { box-shadow: var(--shadow); }
.day-title { font-size: 17px; font-weight: 800; color: var(--ink); margin: 0 0 16px; display: flex; align-items: center; gap: 10px; }
.day-title .day-kcal { font-size: 12px; font-weight: 700; color: var(--green-700); background: var(--green-50); padding: 4px 11px; border-radius: var(--pill); }
.day-title .day-regen { margin-left: auto; font-size: 12px; font-weight: 700; border: 1px solid var(--gray-200); background: var(--card); color: var(--ink-2); padding: 7px 13px; border-radius: var(--pill); cursor: pointer; font-family: inherit; display: inline-flex; align-items: center; gap: 6px; transition: all 0.18s var(--ease); }
.day-title .day-regen .ic { width: 14px; height: 14px; }
.day-title .day-regen:hover { background: var(--green-50); border-color: var(--green-100); color: var(--green-700); }
.meals-row { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }

.meal-card { border: 1px solid var(--gray-200); border-radius: var(--r); overflow: hidden; display: flex; flex-direction: column; background: var(--card); box-shadow: var(--shadow-xs); transition: box-shadow 0.2s var(--ease), transform 0.2s var(--ease), border-color 0.2s var(--ease); }
.meal-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); border-color: var(--green-100); }
.meal-photo { height: 104px; position: relative; display: grid; place-items: center; color: rgba(255, 255, 255, 0.92); }
.meal-photo .ic { width: 34px; height: 34px; stroke-width: 1.6; }
.meal-photo[data-cat="petit-dejeuner"] { background: linear-gradient(135deg, #DCC79A, var(--mc-gold)); }
.meal-photo[data-cat="plat"] { background: linear-gradient(135deg, var(--mc-blue-secondary), var(--mc-blue-dark)); }
.meal-photo[data-cat="collation"] { background: linear-gradient(135deg, #5E80B5, var(--mc-blue)); }
.meal-photo .meal-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
.meal-photo .meal-creneau { position: absolute; top: 10px; left: 12px; z-index: 2; font-size: 10.5px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; background: rgba(0, 0, 0, 0.32); padding: 3px 9px; border-radius: var(--pill); backdrop-filter: blur(4px); }
.meal-photo .meal-fav { position: absolute; top: 8px; right: 10px; z-index: 2; color: #fff; width: 18px; height: 18px; filter: drop-shadow(0 1px 2px rgba(0,0,0,0.3)); }

/* Banniere photo dans la modale recette */
.recipe-photo { position: relative; height: 180px; border-radius: var(--r); overflow: hidden; margin: 0 0 16px; display: grid; place-items: center; color: rgba(255,255,255,0.92); }
.recipe-photo[data-cat="petit-dejeuner"] { background: linear-gradient(135deg, #DCC79A, var(--mc-gold)); }
.recipe-photo[data-cat="plat"] { background: linear-gradient(135deg, var(--mc-blue-secondary), var(--mc-blue-dark)); }
.recipe-photo[data-cat="collation"] { background: linear-gradient(135deg, #5E80B5, var(--mc-blue)); }
.recipe-photo .ic { width: 44px; height: 44px; stroke-width: 1.6; }
.recipe-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.meal-body { padding: 14px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
.meal-name { font-size: 15px; font-weight: 700; color: var(--ink); cursor: pointer; line-height: 1.35; }
.meal-name:hover { color: var(--green-700); }
.macro-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.macro-chip { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 700; color: var(--ink-2); background: var(--gray-100); padding: 4px 9px; border-radius: var(--pill); }
.macro-chip::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--muted); }
.macro-chip.kcal { background: rgba(182,232,79,0.15); color: #CFEE8C; } .macro-chip.kcal::before { background: var(--mc-gold); }
.macro-chip.prot { background: rgba(47,123,255,0.18); color: #A9C9FF; } .macro-chip.prot::before { background: var(--mc-blue-secondary); }
.macro-chip.gluc { background: rgba(148,163,184,0.16); color: #C3CCDA; } .macro-chip.gluc::before { background: #94A3B8; }
.macro-chip.lip { background: rgba(229,181,103,0.15); color: #E7C690; } .macro-chip.lip::before { background: #E5B567; }
.macro-chip.time { background: var(--gray-100); color: var(--ink-2); } .macro-chip.time::before { display: none; }
.macro-chip.time .ic { width: 12px; height: 12px; color: var(--muted); }
.meal-actions { display: flex; gap: 7px; margin-top: auto; }
.mini-btn { flex: 1; font-size: 12.5px; font-weight: 700; border: 1px solid var(--gray-200); background: var(--card); color: var(--ink-2); padding: 8px 6px; border-radius: 11px; cursor: pointer; font-family: inherit; display: inline-flex; align-items: center; justify-content: center; gap: 5px; transition: all 0.16s var(--ease); }
.mini-btn .ic { width: 14px; height: 14px; }
.mini-btn:hover { background: var(--green-50); border-color: var(--green-100); color: var(--green-700); }
.meal-empty { font-size: 13px; color: var(--muted); font-style: italic; }

/* Traceur sur carte repas */
.meal-track { display: flex; gap: 6px; }
.track-btn { flex: 1; border: 1px solid var(--gray-200); background: var(--card); border-radius: 11px; padding: 7px; cursor: pointer; display: grid; place-items: center; color: var(--muted); transition: all 0.16s var(--ease); }
.track-btn .ic { width: 16px; height: 16px; }
.track-btn:hover { background: var(--gray-50); }
.track-btn.on-ok { background: rgba(52,211,153,0.15); border-color: rgba(52,211,153,0.45); color: var(--success); }
.track-btn.on-no { background: rgba(248,113,113,0.15); border-color: rgba(248,113,113,0.45); color: var(--error); }
.track-btn.on-alt { background: rgba(229,181,103,0.15); border-color: rgba(229,181,103,0.45); color: var(--warn); }
.meal-alt { font-size: 12px; color: var(--ink-2); background: var(--gray-50); border: 1px solid var(--gray-100); border-radius: 10px; padding: 7px 11px; display: flex; align-items: center; gap: 7px; }
.meal-alt .ic { width: 14px; height: 14px; color: var(--muted); }

/* ---------- Modale recette ---------- */
.modal-overlay { position: fixed; inset: 0; background: rgba(9, 18, 38, 0.50); backdrop-filter: blur(4px); display: grid; place-items: center; z-index: 50; padding: 18px; animation: fadeIn 0.2s var(--ease); }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.modal { background: var(--card); border-radius: var(--r-xl); max-width: 580px; width: 100%; max-height: 90vh; overflow-y: auto; padding: 28px; position: relative; box-shadow: var(--shadow-md); animation: popIn 0.28s var(--ease); }
@keyframes popIn { from { opacity: 0; transform: translateY(16px) scale(0.98); } to { opacity: 1; transform: none; } }
.modal-close { position: absolute; top: 16px; right: 16px; border: none; background: var(--gray-100); width: 36px; height: 36px; border-radius: 50%; cursor: pointer; color: var(--ink-2); display: grid; place-items: center; transition: background 0.18s var(--ease); z-index: 2; }
.modal-close:hover { background: var(--gray-200); }
.recipe-title { font-size: 24px; color: var(--ink); margin: 0 0 10px; padding-right: 44px; }
.recipe-actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0; }
.recipe-action { font-size: 13px; font-weight: 700; border: 1px solid var(--gray-200); background: var(--card); color: var(--ink-2); padding: 9px 14px; border-radius: var(--pill); cursor: pointer; font-family: inherit; display: inline-flex; align-items: center; gap: 7px; transition: all 0.18s var(--ease); }
.recipe-action .ic { width: 15px; height: 15px; }
.recipe-action:hover { background: var(--green-50); border-color: var(--green-100); color: var(--green-700); }
.recipe-action.fav-on { background: rgba(248, 113, 113, 0.16); border-color: rgba(248, 113, 113, 0.45); color: var(--error); }
.recipe-macros { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 18px 0; }
.recipe-macros .m { background: var(--gray-50); border: 1px solid var(--gray-100); border-radius: 14px; padding: 13px 10px; text-align: center; }
.recipe-macros .m .n { font-weight: 800; color: var(--ink); font-size: 17px; }
.recipe-macros .m .l { font-size: 11px; color: var(--muted); margin-top: 2px; }
.recipe-section-title { font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; margin: 22px 0 10px; color: var(--green-700); }
.ing-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 7px; }
.ing-list li { display: flex; justify-content: space-between; align-items: center; gap: 10px; font-size: 14px; padding: 10px 14px; background: var(--gray-50); border-radius: 11px; }
.ing-list li .q { color: var(--muted); font-weight: 600; white-space: nowrap; }
.ing-left { display: flex; align-items: center; gap: 8px; }
.ing-swap { border: none; background: var(--green-50); color: var(--green-700); border-radius: 8px; width: 26px; height: 26px; cursor: pointer; display: grid; place-items: center; flex: none; transition: background 0.18s var(--ease); }
.ing-swap .ic { width: 14px; height: 14px; }
.ing-swap:hover { background: var(--green-100); }
.steps-list { padding-left: 0; margin: 0; display: grid; gap: 12px; counter-reset: step; list-style: none; }
.steps-list li { font-size: 14.5px; line-height: 1.6; padding-left: 40px; position: relative; min-height: 28px; }
.steps-list li::before { counter-increment: step; content: counter(step); position: absolute; left: 0; top: 0; width: 28px; height: 28px; border-radius: 50%; background: var(--green-50); color: var(--green-700); font-weight: 800; font-size: 13px; display: grid; place-items: center; }

/* Recette guidee : materiel, dressage, generation */
.mat-set { display: flex; flex-wrap: wrap; gap: 8px; }
.mat-chip { display: inline-flex; align-items: center; font-size: 13px; font-weight: 600; color: var(--ink-2); background: var(--gray-100); border: 1px solid var(--gray-200); padding: 6px 12px; border-radius: var(--pill); }
.dressage { font-size: 14.5px; line-height: 1.6; background: var(--green-50); border: 1px solid var(--green-100); border-radius: 12px; padding: 12px 14px; margin: 0; color: var(--ink-2); }
.prep-loading { display: flex; align-items: center; gap: 10px; color: var(--green-700); font-weight: 600; font-size: 14px; background: var(--green-50); border-radius: 12px; padding: 14px 16px; }
.prep-loading .ic { width: 18px; height: 18px; animation: pulse 1.2s ease-in-out infinite; }
@keyframes pulse { 0%,100% { opacity: 0.5; transform: scale(0.92); } 50% { opacity: 1; transform: scale(1.08); } }

/* ---------- Panneaux lateraux ---------- */
.panel { position: fixed; inset: 0; background: rgba(9, 18, 38, 0.48); backdrop-filter: blur(4px); z-index: 50; display: flex; justify-content: flex-end; animation: fadeIn 0.2s var(--ease); }
.panel-inner { background: var(--beige); width: 460px; max-width: 100%; height: 100%; overflow-y: auto; padding: 24px; box-shadow: var(--shadow-md); animation: slideIn 0.3s var(--ease); }
@keyframes slideIn { from { transform: translateX(100%); } to { transform: none; } }
.panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
.panel-head h2 { font-size: 22px; color: var(--ink); display: flex; align-items: center; gap: 10px; }
.panel-head h2 .ic { color: var(--green); }
.panel-sub { color: var(--muted); font-size: 14px; margin: 4px 0 18px; }
.rayon-group { margin-bottom: 20px; }
.rayon-title { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--green-700); margin-bottom: 9px; }
.shop-item { display: flex; align-items: center; gap: 12px; padding: 12px 14px; background: var(--card); border: 1px solid var(--gray-100); border-radius: 13px; margin-bottom: 7px; font-size: 14px; transition: background 0.16s var(--ease); }
.shop-item input { width: 20px; height: 20px; accent-color: var(--green); flex: none; }
.shop-item label { cursor: pointer; flex: 1; }
.shop-item.checked { background: var(--gray-50); }
.shop-item.checked label { text-decoration: line-through; color: var(--muted); }
.shop-item .q { margin-left: auto; color: var(--muted); font-size: 13px; font-weight: 600; }

.fav-item { display: flex; align-items: center; gap: 12px; padding: 14px; background: var(--card); border: 1px solid var(--gray-100); border-radius: 14px; margin-bottom: 9px; box-shadow: var(--shadow-xs); }
.fav-item .fav-name { font-weight: 700; color: var(--ink); cursor: pointer; }
.fav-item .fav-name:hover { color: var(--green-700); }
.fav-item .fav-meta { font-size: 12px; color: var(--muted); margin-left: auto; white-space: nowrap; }
.fav-item .fav-remove { border: none; background: rgba(248,113,113,0.16); color: var(--error); border-radius: 9px; width: 30px; height: 30px; cursor: pointer; flex: none; font-weight: 700; }
.panel-empty { color: var(--muted); font-style: italic; padding: 14px 0; }

/* Ma fiche */
.fiche-block { margin-bottom: 20px; }
.fiche-block h3 { font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--green-700); margin: 0 0 10px; font-weight: 800; }
.fiche-row { display: flex; justify-content: space-between; gap: 12px; padding: 11px 14px; background: var(--card); border: 1px solid var(--gray-100); border-radius: 12px; margin-bottom: 7px; font-size: 14px; }
.fiche-row span { color: var(--muted); }
.fiche-row b { text-align: right; color: var(--ink); }
.fiche-tags { background: var(--green-50); color: var(--green-700); border: 1px solid var(--green-100); border-radius: 12px; padding: 12px 16px; font-size: 14px; font-weight: 700; }

/* Adherence (Mon suivi) */
.adh-gauge { text-align: center; background: linear-gradient(140deg, var(--mc-blue), var(--mc-blue-dark)); color: #fff; border-radius: var(--r-xl); padding: 28px; margin-bottom: 16px; box-shadow: var(--shadow-green); position: relative; overflow: hidden; }
.adh-gauge::after { content: ''; position: absolute; bottom: -50px; left: -30px; width: 180px; height: 180px; border-radius: 50%; background: rgba(255, 255, 255, 0.08); }
.adh-ring { position: relative; width: 132px; height: 132px; margin: 0 auto 6px; }
.adh-ring svg { transform: rotate(-90deg); }
.adh-ring .adh-num { position: absolute; inset: 0; display: grid; place-items: center; font-size: 32px; font-weight: 800; }
.adh-lbl { opacity: 0.9; font-size: 14px; font-weight: 600; position: relative; }
.adh-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 8px; }
.adh-stat { background: var(--card); border: 1px solid var(--gray-100); border-radius: 14px; padding: 14px; text-align: center; }
.adh-stat b { display: block; font-size: 24px; font-weight: 800; color: var(--ink); }
.adh-stat span { font-size: 12px; color: var(--muted); }
.adh-stat.ok b { color: var(--success); }
.adh-stat.alt b { color: var(--warn); }
.adh-stat.no b { color: var(--error); }

/* Carte d'action mise en avant (Affiner mon plan) */
.action-card-accent { border-color: var(--green-100); background: linear-gradient(180deg, var(--green-50) 0%, var(--card) 60%); }
.action-card-accent .action-ic { background: var(--green); color: #fff; }

/* Repas a l'exterieur */
.meal-photo[data-cat="exterieur"] { background: linear-gradient(135deg, #DCC79A, var(--mc-gold)); }
.ext-suggestions { display: grid; gap: 8px; }
.ext-suggestions div { display: flex; align-items: flex-start; gap: 8px; font-size: 13px; color: var(--ink-2); line-height: 1.45; }
.ext-suggestions .ic { width: 15px; height: 15px; color: var(--green); flex: none; margin-top: 2px; }

/* Ajustements de personnalisation (Niveau 2) */
.aj-item { background: var(--green-50); border: 1px solid var(--green-100); border-radius: 12px; padding: 12px 14px; margin-bottom: 9px; }
.aj-item b { display: block; color: var(--green-700); font-size: 14px; margin-bottom: 3px; }
.aj-item span { font-size: 13.5px; color: var(--ink-2); line-height: 1.5; }
.aj-done { background: var(--gray-50); border: 1px solid var(--gray-100); border-radius: 12px; padding: 14px; font-size: 13.5px; color: var(--muted); margin-top: 6px; }

/* Complements alimentaires */
.comp-resume { background: var(--green-50); border: 1px solid var(--green-100); border-radius: 12px; padding: 13px 15px; font-size: 14px; color: var(--ink-2); margin-bottom: 6px; }
.comp-alert { display: flex; gap: 9px; align-items: flex-start; background: rgba(229,181,103,0.10); border: 1px solid rgba(229,181,103,0.35); border-radius: 12px; padding: 12px 14px; font-size: 13.5px; color: #E5B567; margin-bottom: 8px; line-height: 1.5; }
.comp-alert .ic { width: 17px; height: 17px; flex: none; margin-top: 1px; color: var(--warn); }
.comp-item { background: var(--card); border: 1px solid var(--gray-100); border-radius: 13px; padding: 13px 15px; margin-bottom: 9px; box-shadow: var(--shadow-xs); }
.comp-item-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 5px; }
.comp-name { font-weight: 700; color: var(--ink); font-size: 14.5px; }
.comp-deja { font-size: 11px; font-weight: 600; color: var(--muted); background: var(--gray-100); padding: 2px 8px; border-radius: var(--pill); }
.comp-prio { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em; padding: 4px 10px; border-radius: var(--pill); white-space: nowrap; }
.prio-indispensable { background: var(--green); color: #fff; }
.prio-utile { background: rgba(47,123,255,0.18); color: #A9C9FF; }
.prio-optionnel { background: var(--gray-100); color: var(--muted); }
.comp-role { font-size: 13.5px; color: var(--ink-2); line-height: 1.5; }

/* Analyse des ecarts */
.ana-block { border-radius: var(--r); padding: 18px; margin-bottom: 14px; border: 1px solid transparent; }
.ana-block h3 { margin: 0 0 12px; font-size: 16px; display: flex; align-items: center; gap: 9px; }
.ana-block h3 .ic { width: 20px; height: 20px; }
.ana-block ul { margin: 0; padding-left: 0; list-style: none; display: grid; gap: 9px; }
.ana-block li { font-size: 14.5px; line-height: 1.5; padding-left: 26px; position: relative; }
.ana-block li::before { content: ''; position: absolute; left: 6px; top: 8px; width: 7px; height: 7px; border-radius: 50%; }
.ana-forts { background: var(--green-50); border-color: var(--green-100); }
.ana-forts h3 { color: var(--green-700); }
.ana-forts li::before { background: var(--green); }
.ana-axes { background: rgba(229,181,103,0.10); border-color: rgba(229,181,103,0.30); }
.ana-axes h3 { color: #E5B567; }
.ana-axes li::before { background: var(--warn); }

/* ---------- Loader ---------- */
.loader { position: fixed; inset: 0; background: rgba(11, 14, 19, 0.82); backdrop-filter: blur(4px); display: grid; place-items: center; z-index: 60; animation: fadeIn 0.2s var(--ease); }
.loader-card { text-align: center; }
.spinner { width: 46px; height: 46px; border: 4px solid var(--green-100); border-top-color: var(--green); border-radius: 50%; margin: 0 auto 16px; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.loader-card p { color: var(--green-700); font-weight: 700; }

/* ---------- Footer ---------- */
.footer { text-align: center; padding: 28px; color: var(--muted); font-size: 12px; border-top: 1px solid var(--gray-200); margin-top: 36px; }

/* ---------- Responsive ---------- */
/* ---------- Tactile (mobile + tablette <= 1024px) : cibles >= 40-44px ---------- */
@media (max-width: 1024px) {
  .meal-actions, .meal-track { gap: 8px; }
  .mini-btn { min-height: 44px; padding: 10px 8px; font-size: 13px; }
  .track-btn { min-height: 44px; padding: 10px; }
  .track-btn .ic { width: 18px; height: 18px; }
  .day-title .day-regen { min-height: 42px; padding: 10px 14px; }
  .link-btn, #navRestart { min-height: 40px; padding: 9px 14px; }
  .suivi-opt { min-height: 46px; }
  .action-card { min-height: 92px; }
  .portions-ctrl button { width: 40px; height: 40px; }
}

/* ---------- Mobile : < 640px ---------- */
@media (max-width: 640px) {
  #app { padding: 20px 14px 64px; }
  .choice-grid { grid-template-columns: 1fr; }
  .field-row { grid-template-columns: 1fr; }
  .needs-stats { grid-template-columns: repeat(2, 1fr); }
  .recipe-macros { grid-template-columns: repeat(2, 1fr); }
  .panel-inner { width: 100%; padding: 20px 16px; }
  .modal { padding: 22px 18px; }
  .brand-tag { display: none; }
  .hero { padding-top: 32px; }
  .actions-grid { gap: 12px; }
}

/* Tablette (640-1024) : un jour a 4 repas s'affiche en 2x2 (plutot que 3+1). */
@media (min-width: 640px) and (max-width: 1024px) {
  .meals-row.meals-n4 { grid-template-columns: repeat(2, 1fr); }
}
/* Desktop (> 1024) : colonnes nettes selon le nombre de repas du jour, sur toute la largeur. */
@media (min-width: 1025px) {
  .meals-row.meals-n2 { grid-template-columns: repeat(2, 1fr); }
  .meals-row.meals-n3 { grid-template-columns: repeat(3, 1fr); }
  .meals-row.meals-n4 { grid-template-columns: repeat(4, 1fr); }
  .meals-row.meals-n5, .meals-row.meals-n6 { grid-template-columns: repeat(3, 1fr); }
}
/* Grand ecran : on exploite un peu plus la largeur, sans etirer le texte. */
@media (min-width: 1440px) {
  #app { max-width: 1440px; padding-left: 32px; padding-right: 32px; }
  .needs-card { padding: 30px 34px; }
}

/* ---------- Mouvement reduit ---------- */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
}

/* ============ Demande d'aide alimentaire (accompagnement coach) ============ */
.help-cta {
  display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; cursor: pointer;
  background: linear-gradient(135deg, var(--mc-blue) 0%, var(--mc-blue-secondary) 100%);
  color: #fff; border: none; border-radius: 18px; padding: 16px 18px; margin: 4px 0 18px;
  box-shadow: var(--shadow-green); transition: transform .15s var(--ease), box-shadow .15s var(--ease);
}
.help-cta:hover { transform: translateY(-1px); box-shadow: 0 14px 32px rgba(11,61,145,.28); }
.help-cta-ic { flex: 0 0 auto; width: 44px; height: 44px; border-radius: 12px;
  background: rgba(255,255,255,.16); display: flex; align-items: center; justify-content: center; }
.help-cta-ic .ic { width: 24px; height: 24px; }
.help-cta-text { flex: 1 1 auto; display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.help-cta-text strong { font-size: 15px; font-weight: 700; line-height: 1.25; }
.help-cta-text small { font-size: 12.5px; opacity: .88; line-height: 1.35; }
.help-cta-arrow { flex: 0 0 auto; opacity: .9; }
.help-cta-arrow .ic { width: 20px; height: 20px; }

.action-card-admin { position: relative; }
.action-badge { position: absolute; top: 8px; right: 8px; min-width: 20px; height: 20px; padding: 0 6px;
  border-radius: 999px; background: var(--mc-blue); color: #fff; font-size: 11px; font-weight: 700;
  display: inline-flex; align-items: center; justify-content: center; }

.help-options { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 6px; }
.help-opt { cursor: pointer; border: 1.5px solid var(--green-100); background: var(--card); color: var(--ink-2);
  border-radius: 999px; padding: 9px 14px; font-size: 13.5px; font-weight: 500; transition: all .15s var(--ease); }
.help-opt:hover { border-color: var(--mc-blue-secondary); }
.help-opt.selected { background: var(--mc-blue); border-color: var(--mc-blue); color: #fff; font-weight: 600; }

.help-disclaimer { font-size: 12px; color: var(--muted); background: var(--mc-blue-soft); border-radius: 12px;
  padding: 10px 12px; margin: 14px 0; line-height: 1.45; }

.help-done { text-align: center; padding: 24px 8px; }
.help-done-ic { width: 64px; height: 64px; margin: 0 auto 14px; border-radius: 50%;
  background: rgba(22,163,74,.12); color: var(--success); display: flex; align-items: center; justify-content: center; }
.help-done-ic .ic { width: 32px; height: 32px; }
.help-done h3 { font-size: 19px; color: var(--ink); margin: 0 0 8px; }
.help-done p { color: var(--ink-2); line-height: 1.5; margin: 0 0 18px; }

.help-empty { color: var(--muted); text-align: center; padding: 30px 0; }
.help-req { background: var(--card); border: 1px solid var(--mc-border); border-left: 4px solid var(--mc-blue);
  border-radius: 14px; padding: 14px 16px; margin-bottom: 12px; box-shadow: var(--shadow-xs); }
.help-req.statut-traite { border-left-color: var(--success); opacity: .82; }
.help-req.statut-en_cours { border-left-color: var(--warn); }
.help-req-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.help-req-head strong { font-size: 15px; color: var(--ink); }
.help-req-date { font-size: 12px; color: var(--muted); margin-top: 2px; }
.help-req-tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
.help-tag { font-size: 12px; background: var(--mc-blue-soft); color: var(--mc-blue-dark); border-radius: 999px; padding: 4px 10px; }
.help-tag.muted { background: var(--gray-100); color: var(--muted); }
.help-req-msg { font-size: 13.5px; color: var(--ink-2); line-height: 1.45; margin: 8px 0;
