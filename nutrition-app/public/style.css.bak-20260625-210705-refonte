.plate-coach p { margin: 0; font-size: 13.5px; line-height: 1.45; color: var(--ink-2); }
.plate-coach.pc-action { background: var(--mc-blue-soft); }
.plate-coach.pc-action .pc-l { color: var(--mc-blue-dark); }

/* vue coach analyses d'assiettes */
.plate-req { background: var(--card); border: 1px solid var(--mc-border); border-radius: 14px; padding: 14px; margin-bottom: 12px; box-shadow: var(--shadow-xs); }
.plate-req-top { display: flex; gap: 12px; }
.plate-req-thumb { width: 72px; height: 72px; border-radius: 12px; object-fit: cover; flex: 0 0 auto; border: 1px solid var(--mc-border); }
.plate-req-info { min-width: 0; flex: 1; }
.plate-req-macros { font-size: 13px; color: var(--ink-2); font-weight: 600; margin-top: 4px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.plate-drop-empty span { display: flex; flex-direction: column; gap: 3px; }
.plate-drop-empty small { font-size: 12px; font-weight: 500; color: var(--muted); }
.plate-drop { -webkit-tap-highlight-color: transparent; }

/* ============ Google Agenda ============ */
.agenda-state { display: flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 600; color: var(--ink-2); margin: 4px 0 14px; }
.agenda-dot { width: 9px; height: 9px; border-radius: 50%; background: #D6DAE0; flex: none; }
.agenda-dot.on { background: var(--success); }
.agenda-dot.off { background: var(--warn); }
.agenda-choices { display: grid; gap: 10px; margin: 6px 0 4px; }
.agenda-choices .btn { width: 100%; }
.agenda-msg { font-size: 13px; color: var(--ink-2); margin: 8px 0; min-height: 18px; }
.agenda-success { color: var(--success); font-weight: 600; }
.agenda-warn { background: rgba(184,146,74,.12); color: var(--warn); border-radius: 10px; padding: 9px 12px; font-size: 12.5px; }
.choice-grid-3 { grid-template-columns: repeat(3, 1fr); }
@media (max-width: 640px) { .choice-grid-3 { grid-template-columns: 1fr 1fr 1fr; } }
